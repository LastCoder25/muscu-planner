{
  "extends": "./.quasar/tsconfig.json",
  "compilerOptions": {
    // Désactivé pour intégrer src/lib (contrat JSON v1.0) sans le réécrire.
    // On conserve `strict: true` ; seul ce flag ultra-strict est relâché.
    "exactOptionalPropertyTypes": false
  },
  // Réplique les exclusions de base + `test/` (les tests Vitest sont transpilés
  // par esbuild, pas type-checkés par vue-tsc). `exclude` REMPLACE le parent.
  "exclude": [
    // ⚠️ Code DENO (edge functions) : autre runtime, autres globales (`Deno`,
    // specificateurs `npm:`). Le compiler avec la config de l'app ne prouverait rien
    // et echouerait toujours. Meme politique que `test/`.
    "supabase",
    "dist",
    "node_modules",
    "src-capacitor",
    "src-cordova",
    "quasar.config.*.temporary.compiled*",
    "test"
  ]
}
