# Copie ce fichier en .env (et .env à la racine du projet Quasar).
# @quasar/app-vite charge automatiquement .env et expose ces variables via process.env.
# La clé anon est PUBLIQUE par design — la sécurité repose sur les RLS Postgres.
SUPABASE_URL=https://VOTRE-PROJET.supabase.co
SUPABASE_ANON_KEY=VOTRE-CLE-ANON

# Compte de test du smoke UI (optionnel). Sans ces deux lignes, `npm run smoke` s'arrête
# à l'écran de connexion et ne voit donc aucun écran de jeu — c'est le comportement
# historique, sans régression. Pour les obtenir : `node scripts/seed-smoke-account.mjs`.
# ⚠️ JAMAIS de vraies valeurs ici : ce fichier est versionné, `.env` ne l'est pas.
SMOKE_EMAIL=
SMOKE_PASSWORD=
